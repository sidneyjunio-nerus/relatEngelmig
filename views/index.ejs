<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nérus - Orçamento com imagem</title>
  <link rel="stylesheet" href="/static/style.css" />
</head>

<body>
  <main class="container">
    <header class="page-header">
      <h1>Orçamento <span class="brand-mark">Nérus</span></h1>
      <p>Informe loja e pedido para localizar o TXT/PRN.</p>
    </header>

    <section class="search-panel">
      <form method="post" action="/orcamento" class="search-form js-loading-form">
        <label>
          Loja
          <input type="text" name="loja" value="<%= form.loja %>" required />
        </label>

        <label>
          Pedido
          <input type="text" name="pedido" value="<%= form.pedido %>" required />
        </label>

        <button type="submit">Buscar orçamento</button>
      </form>
    </section>

    <% if (error) { %>
      <div class="alert error">
        <%= error %>
      </div>
      <% } %>

        <% if (budget) { %>
          <% const brl=new Intl.NumberFormat("pt-BR", { style: "currency" , currency: "BRL" }); const fmtMoney=(raw,
            num)=> (raw && raw !== "-" ? raw : (typeof num === "number" ? brl.format(num) : "-"));
            const fmtMoneyZero = (raw, num) => (raw && raw !== "-" ? raw : (typeof num === "number" ? brl.format(num) :
            brl.format(0)));
            const fmtQty = (raw, num) => (raw && raw !== "-" ? raw : (typeof num === "number" ? String(num) : "-"));
            const stripCodePrefix = (value) => String(value || "").replace(/^\s*\d+\s*-\s*/i, "").trim();
            const stripLeadingDashes = (value) => String(value || "").replace(/^\s*(?:-\s*)+/, "").trim();
            const cleanStoreField = (value) => stripLeadingDashes(String(value || "").replace(/\s+/g, " ").trim());
            const parseMoneyLike = (raw, numeric) => {
            if (typeof numeric === "number" && Number.isFinite(numeric)) return numeric;
            const normalized = String(raw || "")
            .replace(/\s/g, "")
            .replace(/[^\d,.-]/g, "")
            .replace(/\.(?=\d{3}(?:\D|$))/g, "")
            .replace(",", ".");
            const parsed = Number(normalized);
            return Number.isFinite(parsed) ? parsed : null;
            };
            const buildPhone = (dddValue, telValue, fallbackValue) => {
            const formatLocal = (digits) => {
            if (digits.length === 8) return `${digits.slice(0, 4)}-${digits.slice(4)}`;
            if (digits.length === 9) return `${digits.slice(0, 5)}-${digits.slice(5)}`;
            return digits;
            };

            const onlyDigits = (value) => String(value || "").replace(/\D+/g, "");
            const ddd = onlyDigits(dddValue).slice(0, 2);
            const telDigits = onlyDigits(telValue).replace(/^0+/, "");
            const fallbackDigits = onlyDigits(fallbackValue).replace(/^0+/, "");

            const phoneCandidates = [telDigits, fallbackDigits]
            .map((digits) => {
            if (!digits) return "";
            if (ddd && digits.startsWith(ddd) && digits.length >= 10) {
            const withoutDdd = digits.slice(2);
            if (withoutDdd.length === 8 || withoutDdd.length === 9) return withoutDdd;
            }
            if (digits.length > 11) return digits.slice(-9);
            if (digits.length === 10) return digits.slice(-8);
            if (digits.length === 11) return digits.slice(-9);
            return digits;
            })
            .filter((digits) => digits.length >= 8);

            const local = phoneCandidates[0] || "";
            if (!local) return "";
            if (!ddd) return formatLocal(local);
            return `${ddd} ${formatLocal(local)}`;
            };
            const lojaLabel = budget.storeName || budget.fields.LJNA || budget.loja || "-";
            const lojaNo = budget.storeNo || budget.loja || "-";
            const orcamentoNo = budget.fields.PDNO || budget.pedido || "-";
            const customer = budget.customer || {};
            const customerName = customer.nome || budget.fields.CTNA || "-";
            const customerCpf = customer.cpf || "-";
            const customerNascimento = customer.nascimento || "-";
            const customerEmail = customer.email || "-";
            const customerTel = buildPhone(customer.ddd, customer.tel, budget.fields.CTTL) || "-";
            const customerCel = customer.celular && customer.celular !== "0" ? customer.celular : "-";
            const customerEndereco = customer.endereco || budget.fields.CTED || "-";
            const customerNumero = customer.numero || "";
            const customerCompl = customer.complemento || "";
            const customerBairro = String(customer.bairro || budget.fields.CTBA || "-").trim();
            const customerCidade = customer.cidade || budget.fields.CTCD || "-";
            const customerUf = customer.uf || "";
            const customerCep = customer.cep ? customer.cep.split(/\s+/)[0] : "-";
            const lojaEndereco = [budget.fields.LJEN, budget.fields.LJBA]
            .map((value) => cleanStoreField(value))
            .filter((value) => value && value !== "-")
            .join(" - ");
            const lojaCidadeUf = [budget.fields.LJCD, budget.fields.LJUF]
            .map((value) => cleanStoreField(value))
            .filter((value) => value && value !== "-")
            .join(" / ");
            const lojaEnderecoCompleto = [lojaEndereco, lojaCidadeUf]
            .filter(Boolean)
            .join(" - ")
            .replace(/^\s*(?:-\s*)+/, "")
            .trim();
            const vendedorLabel = budget.fields.SPNO ? `${budget.fields.SPNO} - ${budget.fields.SPAP || ""}` :
            (budget.fields.SPAP || "-");
            const customerCityState = [customerCidade, customerUf].filter(Boolean).join(" - ");
            const paymentLabel = stripCodePrefix(budget.totals.PAGC || budget.fields.PGTO || "") || "0";
            const subtotalNum = parseMoneyLike(budget.totals.SUBT, budget.totals.subtotal);
            const acrescimoNum = parseMoneyLike(budget.totals.ACPO, budget.totals.acrescimo);
            const descontoNum = parseMoneyLike(budget.totals.DESC, budget.totals.desconto);
            const totalNum = parseMoneyLike(budget.totals.TDAC, budget.totals.totalFinal);
            const isZeroOrMissing = (value) => value === null || value === 0;
            const shouldUseTotalAsPurchase = isZeroOrMissing(subtotalNum) && totalNum && totalNum > 0 &&
            isZeroOrMissing(acrescimoNum) && isZeroOrMissing(descontoNum);
            const compraRaw = shouldUseTotalAsPurchase ? (budget.totals.TDAC || budget.totals.SUBT) : budget.totals.SUBT;
            const compraNum = shouldUseTotalAsPurchase ? totalNum : subtotalNum;
            %>
            <section class="budget budget-modern">
              <div class="budget-top">
                <button onclick="window.print()" type="button">Imprimir / PDF</button>
              </div>

              <article class="quote-sheet">
                <section class="quote-top-card">
                  <header class="quote-header">
                    <div class="quote-head-main">
                      <div class="quote-id">
                        <p class="quote-label">ORÇAMENTO Nº</p>
                        <h3>
                          <%= orcamentoNo %>
                        </h3>
                      </div>
                      <img class="quote-brand" src="/static/image.png" alt="Engelmig" />
                    </div>
                    <p class="quote-vendor">Vendedor: <strong>
                        <%= vendedorLabel %>
                      </strong></p>
                  </header>

                  <section class="quote-section">
                    <h4>Dados do cliente</h4>
                    <div class="client-grid">
                      <p class="client-name">
                        <%= customerName %>
                      </p>
                      <div class="client-info-grid">
                        <p class="client-line with-icon">
                          <span class="ci-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="ci-icon-svg">
                              <rect x="3" y="5" width="18" height="14" rx="2" />
                              <circle cx="8.5" cy="11" r="2" />
                              <path d="M14 10h4M14 13h4M6 15h6" />
                            </svg>
                          </span>
                          <span>
                            <%= customerCpf %>
                          </span>
                        </p>
                        <p class="client-line with-icon">
                          <span class="ci-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="ci-icon-svg">
                              <rect x="3" y="5" width="18" height="14" rx="2" />
                              <path d="m4 7 8 6 8-6" />
                            </svg>
                          </span>
                          <span>
                            <%= customerEmail %>
                          </span>
                        </p>
                        <p class="client-line with-icon">
                          <span class="ci-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" class="lucide lucide-cake-icon lucide-cake">
                              <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8" />
                              <path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1" />
                              <path d="M2 21h20" />
                              <path d="M7 8v3" />
                              <path d="M12 8v3" />
                              <path d="M17 8v3" />
                              <path d="M7 4h.01" />
                              <path d="M12 4h.01" />
                              <path d="M17 4h.01" />
                            </svg>
                          </span>
                          <span>
                            <%= customerNascimento %>
                          </span>
                        </p>
                        <p class="client-line with-icon">
                          <span class="ci-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="ci-icon-svg">
                              <path
                                d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10.1a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.6 1.9Z" />
                            </svg>
                          </span>
                          <span>
                            <%= customerTel %>
                          </span>
                        </p>
                      </div>
                    </div>
                  </section>

                  <section class="quote-section">
                    <h4>Endereço de entrega</h4>
                    <article class="address-card">
                      <h5>Entrega</h5>
                      <div class="address-grid">
                        <p class="address-main">
                          <%= customerEndereco %>
                            <%= customerNumero ? `, ${customerNumero}` : "" %>
                        </p>
                        <% if (customerCompl) { %>
                          <p class="address-main">
                            <%= customerCompl %>
                          </p>
                          <% } %>
                            <p class="address-detail"><strong>Bairro:</strong> <span>
                                <%= customerBairro %>
                              </span></p>
                            <p class="address-detail"><strong>Cidade/UF:</strong> <span>
                                <%= customerCityState || "-" %>
                              </span></p>
                            <p class="address-detail"><strong>CEP:</strong> <span>
                                <%= customerCep %>
                              </span></p>
                      </div>
                    </article>
                  </section>
                </section>

                <section class="quote-items-card">
                  <section class="quote-section">
                    <div class="items-head">
                      <h4>Itens</h4>
                      <span class="items-count">
                        <%= budget.totalItens %> item(ns)
                      </span>
                    </div>
                    <div class="items-list">
                      <% budget.items.forEach((item)=> { %>
                        <article class="product-card">
                          <img class="product-photo" src="<%= item.fotoUrl %>"
                            alt="Foto do produto <%= item.ean || item.sku || item.codigo %>" loading="lazy" />
                          <div class="product-main">
                            <p class="product-name">
                              <%= item.nome || "-" %>
                            </p>
                            <p class="product-meta">Cód. <%= item.codigo || "-" %> · Grade <%= item.grade || "-" %> · UN
                                  <%= item.unidade || "-" %>
                            </p>
                          </div>
                          <div class="product-side">
                            <p class="qty-value">
                              <%= fmtQty(item.quantidadeRaw, item.quantidade) %>
                            </p>
                            <p class="qty-label">Quantidade</p>
                          </div>
                        </article>
                        <% }) %>
                    </div>
                  </section>

                  <section class="quote-totals">
                    <div class="totals-card">
                      <p><span>Condição de pagamento</span><strong>
                          <%= paymentLabel %>
                        </strong></p>
                      <p><span>Valor da compra</span><strong>
                          <%= fmtMoneyZero(compraRaw, compraNum) %>
                        </strong></p>
                      <p><span>Acréscimo</span><strong>
                          <%= fmtMoneyZero(budget.totals.ACPO, budget.totals.acrescimo) %>
                        </strong></p>
                      <p><span>Desconto total</span><strong>
                          <%= fmtMoneyZero(budget.totals.DESC, budget.totals.desconto) %>
                        </strong></p>
                      <p class="total-final"><span>TOTAL</span><strong>
                          <%= fmtMoneyZero(budget.totals.TDAC, budget.totals.totalFinal) %>
                        </strong></p>
                    </div>
                    <div class="store-footer">
                      <p>ENDEREÇO DA LOJA: <strong>
                          <%= lojaEnderecoCompleto || "-" %>
                        </strong></p>
                      <p>TELEFONE: <strong>
                          <%= budget.fields.LJTL || "-" %>
                        </strong></p>
                    </div>
                  </section>
                </section>
              </article>
            </section>
            <% } %>
  </main>

  <div class="loading-overlay" aria-hidden="true">
    <div class="loading-card">
      <div class="spinner"></div>
      <h3>Varredura em andamento</h3>
      <p class="loading-status" data-loading-status>Localizando arquivos de orçamento...</p>
    </div>
  </div>

  <script>
    (() => {
      const forms = document.querySelectorAll(".js-loading-form");
      const statusEl = document.querySelector("[data-loading-status]");
      const steps = [
        "Localizando arquivos de orçamento...",
        "Validando loja e pedido...",
        "Conferindo produtos e imagens...",
        "Montando orçamento moderno..."
      ];
      let intervalId = null;
      let index = 0;

      function startLoading() {
        if (document.body.classList.contains("loading")) return;
        document.body.classList.add("loading");
        if (!statusEl) return;
        statusEl.textContent = steps[0];
        intervalId = setInterval(() => {
          index = (index + 1) % steps.length;
          statusEl.textContent = steps[index];
        }, 900);
      }

      forms.forEach((form) => {
        form.addEventListener("submit", () => {
          startLoading();
          form.querySelectorAll("button[type='submit']").forEach((btn) => {
            btn.setAttribute("disabled", "disabled");
          });
        });
      });

      window.addEventListener("pageshow", () => {
        if (intervalId) clearInterval(intervalId);
        document.body.classList.remove("loading");
      });
    })();
  </script>
</body>

</html>