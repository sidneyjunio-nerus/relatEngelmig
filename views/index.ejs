<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nérus - Orçamento com imagem</title>
    <link rel="stylesheet" href="/static/style.css" />
  </head>
  <body>
    <main class="container">
      <header class="page-header">
        <h1>Orçamento <span class="brand-mark">Nérus</span></h1>
        <p>Informe loja e pedido para localizar o TXT/PRN.</p>
      </header>

      <section class="search-panel">
        <form method="post" action="/orcamento" class="search-form js-loading-form">
          <label>
            Loja
            <input type="text" name="loja" value="<%= form.loja %>" required />
          </label>

          <label>
            Pedido
            <input type="text" name="pedido" value="<%= form.pedido %>" required />
          </label>

          <button type="submit">Buscar orçamento</button>
        </form>
      </section>

      <% if (error) { %>
      <div class="alert error"><%= error %></div>
      <% } %>

      <% if (budget) { %>
      <% 
        const brl = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
        const fmtMoney = (raw, num) => (raw && raw !== "-" ? raw : (typeof num === "number" ? brl.format(num) : "-"));
        const fmtMoneyZero = (raw, num) => (raw && raw !== "-" ? raw : (typeof num === "number" ? brl.format(num) : brl.format(0)));
        const fmtQty = (raw, num) => (raw && raw !== "-" ? raw : (typeof num === "number" ? String(num) : "-"));
        const stripCodePrefix = (value) => String(value || "").replace(/^\s*\d+\s*-\s*/i, "").trim();
        const lojaLabel = budget.storeName || budget.fields.LJNA || budget.loja || "-";
        const lojaNo = budget.storeNo || budget.loja || "-";
        const orcamentoNo = budget.fields.PDNO || budget.pedido || "-";
        const customer = budget.customer || {};
        const customerCode = customer.codigo || budget.fields.CTNO || "";
        const customerName = customer.nome || budget.fields.CTNA || "-";
        const customerCpf = customer.cpf || "-";
        const customerNascimento = customer.nascimento || "-";
        const customerEmail = customer.email || "-";
        const customerTel = [customer.ddd, customer.tel].filter(Boolean).join(" ").replace(/\s+/g, " ").trim() || budget.fields.CTTL || "-";
        const customerCel = customer.celular && customer.celular !== "0" ? customer.celular : "-";
        const customerEndereco = customer.endereco || budget.fields.CTED || "-";
        const customerNumero = customer.numero || "";
        const customerCompl = customer.complemento || "";
        const customerBairro = customer.bairro || budget.fields.CTBA || "-";
        const customerCidade = customer.cidade || budget.fields.CTCD || "-";
        const customerUf = customer.uf || "";
        const customerCep = customer.cep ? customer.cep.split(/\s+/)[0] : "-";
        const lojaEndereco = [budget.fields.LJEN, budget.fields.LJBA].filter(Boolean).join(" - ");
        const lojaCidadeUf = [budget.fields.LJCD, budget.fields.LJUF].filter(Boolean).join(" / ");
        const vendedorLabel = budget.fields.SPNO ? `${budget.fields.SPNO} - ${budget.fields.SPAP || ""}` : (budget.fields.SPAP || "-");
        const customerCityState = [customerCidade, customerUf].filter(Boolean).join(" - ");
        const paymentLabel = stripCodePrefix(budget.totals.PAGC || budget.fields.PGTO || "") || "0";
      %>
      <section class="budget budget-modern">
        <div class="budget-top">
          <div class="budget-title-wrap">
            <h2>Prévia do orçamento</h2>
            <p>Layout moderno e limpo, no padrão visual do PDF de referência.</p>
          </div>
          <button onclick="window.print()" type="button">Imprimir / PDF</button>
        </div>

        <article class="quote-sheet">
          <section class="quote-top-card">
            <header class="quote-header">
              <div class="quote-head-main">
                <div>
                  <p class="quote-label">ORÇAMENTO Nº</p>
                  <h3><%= orcamentoNo %></h3>
                </div>
                <p class="quote-brand">abc da construção</p>
              </div>
              <p class="quote-vendor">Vendedor: <strong><%= vendedorLabel %></strong></p>
            </header>

            <section class="quote-section">
              <h4>Dados do cliente</h4>
              <div class="client-grid">
                <div>
                  <p class="client-name"><%= customerName %></p>
                  <% if (customerCode) { %>
                  <p class="client-line with-icon">
                    <span class="ci-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="ci-icon-svg"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="12" r="2"/><path d="M14 10h4M14 13h4"/></svg>
                    </span>
                    <span><%= customerCode %></span>
                  </p>
                  <% } %>
                  <p class="client-line with-icon">
                    <span class="ci-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="ci-icon-svg"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 14c1.4-2 3.6-2 5 0"/><circle cx="8.5" cy="10.5" r="1"/><circle cx="12.5" cy="10.5" r="1"/></svg>
                    </span>
                    <span><%= customerCpf %></span>
                  </p>
                  <p class="client-line with-icon">
                    <span class="ci-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="ci-icon-svg"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg>
                    </span>
                    <span><%= customerNascimento %></span>
                  </p>
                </div>
                <div>
                  <p class="client-line with-icon">
                    <span class="ci-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="ci-icon-svg"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                    </span>
                    <span><%= customerEmail %></span>
                  </p>
                  <p class="client-line with-icon">
                    <span class="ci-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="ci-icon-svg"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10.1a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.6 1.9Z"/></svg>
                    </span>
                    <span><%= customerTel %></span>
                  </p>
                  <p class="client-line with-icon">
                    <span class="ci-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="ci-icon-svg"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>
                    </span>
                    <span><%= customerCel %></span>
                  </p>
                </div>
              </div>
            </section>

            <section class="quote-section">
              <h4>Endereço de entrega</h4>
              <article class="address-card">
                <h5>Entrega</h5>
                <p><%= customerEndereco %><%= customerNumero ? `, ${customerNumero}` : "" %></p>
                <% if (customerCompl) { %><p><%= customerCompl %></p><% } %>
                <p><%= customerBairro %></p>
                <p><%= customerCityState || "-" %></p>
                <p>CEP: <%= customerCep %></p>
              </article>
            </section>
          </section>

          <section class="quote-items-card">
            <section class="quote-section">
              <div class="items-head">
                <h4>Itens</h4>
                <span class="items-count"><%= budget.totalItens %> item(ns)</span>
              </div>
              <div class="items-list">
                <% budget.items.forEach((item) => { %>
                <article class="product-card">
                  <img class="product-photo" src="<%= item.fotoUrl %>" alt="Foto do produto <%= item.ean || item.sku || item.codigo %>" loading="lazy" />
                  <div class="product-main">
                    <p class="product-name"><%= item.nome || "-" %></p>
                    <p class="product-meta">Cód. <%= item.codigo || "-" %> · Grade <%= item.grade || "-" %> · UN <%= item.unidade || "-" %></p>
                  </div>
                  <div class="product-side">
                    <p class="qty-value"><%= fmtQty(item.quantidadeRaw, item.quantidade) %></p>
                    <p class="qty-label">Quantidade</p>
                  </div>
                </article>
                <% }) %>
              </div>
            </section>

            <section class="quote-totals">
              <div class="totals-card">
                <p><span>Condição de pagamento</span><strong><%= paymentLabel %></strong></p>
                <p><span>Valor da compra</span><strong><%= fmtMoneyZero(budget.totals.SUBT, budget.totals.subtotal) %></strong></p>
                <p><span>Acréscimo</span><strong><%= fmtMoneyZero(budget.totals.ACPO, budget.totals.acrescimo) %></strong></p>
                <p><span>Desconto total</span><strong><%= fmtMoneyZero(budget.totals.DESC, budget.totals.desconto) %></strong></p>
                <p class="total-final"><span>TOTAL</span><strong><%= fmtMoneyZero(budget.totals.TDAC, budget.totals.totalFinal) %></strong></p>
              </div>
              <div class="store-footer">
                <p>ENDEREÇO DA LOJA: <strong><%= lojaEndereco || "-" %> - <%= lojaCidadeUf || "-" %></strong></p>
                <p>TELEFONE: <strong><%= budget.fields.LJTL || "-" %></strong></p>
              </div>
            </section>
          </section>
        </article>
      </section>
      <% } %>
    </main>

    <div class="loading-overlay" aria-hidden="true">
      <div class="loading-card">
        <div class="spinner"></div>
        <h3>Varredura em andamento</h3>
        <p class="loading-status" data-loading-status>Localizando arquivos de orçamento...</p>
      </div>
    </div>

    <script>
      (() => {
        const forms = document.querySelectorAll(".js-loading-form");
        const statusEl = document.querySelector("[data-loading-status]");
        const steps = [
          "Localizando arquivos de orçamento...",
          "Validando loja e pedido...",
          "Conferindo produtos e imagens...",
          "Montando orçamento moderno..."
        ];
        let intervalId = null;
        let index = 0;

        function startLoading() {
          if (document.body.classList.contains("loading")) return;
          document.body.classList.add("loading");
          if (!statusEl) return;
          statusEl.textContent = steps[0];
          intervalId = setInterval(() => {
            index = (index + 1) % steps.length;
            statusEl.textContent = steps[index];
          }, 900);
        }

        forms.forEach((form) => {
          form.addEventListener("submit", () => {
            startLoading();
            form.querySelectorAll("button[type='submit']").forEach((btn) => {
              btn.setAttribute("disabled", "disabled");
            });
          });
        });

        window.addEventListener("pageshow", () => {
          if (intervalId) clearInterval(intervalId);
          document.body.classList.remove("loading");
        });
      })();
    </script>
  </body>
</html>
