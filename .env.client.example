# Imagem publicada no GHCR
# Ex.: ghcr.io/<owner>/<repo>:latest
GHCR_IMAGE=ghcr.io/OWNER/relatengelmig:latest

# Porta local publicada para o cliente
PORT=3210

# Pasta local do cliente com TXT/PRN do NW
# Será montada no container em /data/print
CLIENT_PRINT_ROOT=/v/saci/print

# A aplicação lê desta pasta dentro do container
PRINT_ROOT=/data/print

# Banco MySQL na VPN interna do cliente
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sqldados
